# Copiar a .env (git-ignored). El gateway lo carga al arrancar.

# Gateway
PORT=8787
# El acceso a la web es por LOGIN con las credenciales del router (abajo).
# GATEWAY_TOKEN es OPCIONAL: API-key para clientes/tests. Vacío = solo login (recomendado).
GATEWAY_TOKEN=
# Origenes CORS permitidos: "*" (dev) o lista separada por comas.
CORS_ORIGIN=*
# Carpeta de la web a servir. Vacío = autodetecta apps/web/dist.
WEB_DIR=

# Router objetivo.
# ROUTER_DRIVER vacío = autodetecta el driver por sondas. Fíjalo para forzar uno.
ROUTER_DRIVER=
# ROUTER_BASE_URL vacío = AUTODETECTA el router (puerta de enlace de la LAN). Fíjalo para forzar una IP.
ROUTER_BASE_URL=
ROUTER_USERNAME=admin
ROUTER_PASSWORD=
# Si el panel https usa cert self-signed, poner 1 para no verificar TLS hacia el router.
ROUTER_INSECURE_TLS=0
