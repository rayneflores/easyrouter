{
  "name": "@ryfsystems/desktop",
  "version": "1.1.1",
  "private": true,
  "description": "EasyRouter — app de escritorio (ryfsystems)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "es.ryfsystems.easyrouter",
    "productName": "EasyRouter",
    "electronVersion": "33.4.11",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rayneflores",
        "repo": "easyrouter"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "author": "Ing. Rayne Flores <rayne.flores@tribucorp.es>",
  "publisher": "ryfsystems",
  "dependencies": {
    "@capacitor/cli": "8.4.3",
    "@fastify/static": "10.1.6",
    "electron-updater": "^6.8.9"
  }
}
