{
  "name": "@ryfsystems/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "EasyRouter — app de escritorio (ryfsystems)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "es.ryfsystems.easyrouter",
    "productName": "EasyRouter",
    "files": ["electron/**/*"],
    "linux": { "target": ["AppImage"], "category": "Network" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] }
  },
  "author": "Ing. Rayne Flores <rayne.flores@tribucorp.es>",
  "publisher": "ryfsystems"
}
